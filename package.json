{
  "name": "nextn",
  "version": "1.0.0",
  "description": "A desktop application, based on React und Next.js, to manage your anime library.",
  "author": "Robin Kirch",
  "type": "module",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev -p 9002",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "check": "npm run typecheck && npm run lint && npm run test",
    "electron:build-main": "esbuild electron/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=electron/dist/main.js && esbuild electron/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --sourcemap --outfile=electron/dist/preload.cjs",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:9002 && npm run electron:build-main && cross-env NODE_ENV=development electron .\"",
    "package:electron": "npm run build && npm run electron:build-main && electron-builder --win --publish never",
    "release:build": "npm run check && npm run package:electron",
    "release:publish": "npm run check && npm run build && npm run electron:build-main && electron-builder --win --publish always"
  },
  "dependencies": {
    "@genkit-ai/anthropic": "^0.6.0",
    "@genkit-ai/google-genai": "^1.43.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "geist": "^1.8.2",
    "genkit": "^1.43.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.animeshelf.app",
    "asar": false,
    "npmRebuild": false,
    "productName": "AnimeShelf",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/dist/**",
      "package.json",
      "next.config.ts",
      {
        "from": ".next",
        "to": ".next",
        "filter": [
          "**/*",
          "!cache/**",
          "!dev/**"
        ]
      },
      {
        "from": "public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/AnimeShelf.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "robinkirch",
        "repo": "AnimeShelf",
        "releaseType": "draft"
      }
    ],
    "nsis": {
      "artifactName": "AnimeShelf-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
